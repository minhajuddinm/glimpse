{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts",
    "bench/**/*.ts",
    "vitest.bench.mts",
    "scripts/**/*.mts",
    "electron.vite.config.mts",
    "vitest.config.mts"
  ]
}
