{
  "name": "glimpse",
  "productName": "Glimpse",
  "version": "0.1.0",
  "description": "Invisible real-time call copilot for Windows: local transcription, answers from your own notes",
  "private": true,
  "license": "MIT",
  "author": "Glimpse contributors",
  "homepage": "https://github.com/minhajuddinm/glimpse",
  "repository": {
    "type": "git",
    "url": "https://github.com/minhajuddinm/glimpse.git"
  },
  "bugs": {
    "url": "https://github.com/minhajuddinm/glimpse/issues"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "dist": "node scripts/dist.mjs",
    "selftest": "electron-vite build && electron . --selftest",
    "canary": "electron-vite build && electron . --canary=60",
    "fetch-models": "node scripts/fetch-models.mts",
    "bench:audio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gen-bench-audio.ps1",
    "bench:asr": "node scripts/bench-asr.mts",
    "icons": "electron scripts/render-icons.cjs",
    "bench:pipeline": "node scripts/bench-pipeline.mts",
    "bench:kb": "vitest run -c vitest.bench.mts --reporter verbose",
    "bench:answer": "electron-vite build && electron . --answer-bench",
    "bench:idle": "node scripts/bench-idle.mts",
    "bench:minutes": "electron-vite build && electron . --minutes-bench"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@huggingface/transformers": "4.3.2",
    "ical.js": "2.2.1",
    "koffi": "3.3.8",
    "lucide-react": "1.76.0",
    "mammoth": "1.13.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sherpa-onnx-node": "2.0.1",
    "unpdf": "2.2.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "dev.glimpse.app",
    "productName": "Glimpse",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Glimpse transcribes your side of the conversation on this Mac. Audio never leaves your computer.",
        "NSAudioCaptureUsageDescription": "Glimpse transcribes the other side of the call from your system audio on this Mac. Audio never leaves your computer."
      }
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "models/embeddings",
        "to": "models/embeddings"
      },
      {
        "from": "models/silero-vad",
        "to": "models/silero-vad"
      },
      {
        "from": "models/sherpa-onnx-streaming-zipformer-en-kroko-2025-08-06",
        "to": "models/sherpa-onnx-streaming-zipformer-en-kroko-2025-08-06"
      }
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**",
      "node_modules/koffi/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "copyright": "Copyright © 2026 Glimpse contributors"
  }
}
