{
  "name": "glimpse",
  "productName": "Glimpse",
  "version": "0.1.0",
  "description": "Invisible real-time conversation copilot for Windows",
  "private": true,
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "selftest": "electron-vite build && electron . --selftest",
    "canary": "electron-vite build && electron . --canary=60",
    "fetch-models": "node scripts/fetch-models.mts",
    "bench:audio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gen-bench-audio.ps1",
    "bench:asr": "node scripts/bench-asr.mts",
    "icons": "electron scripts/render-icons.cjs",
    "bench:pipeline": "node scripts/bench-pipeline.mts",
    "bench:kb": "vitest run -c vitest.bench.mts --reporter verbose"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@huggingface/transformers": "4.3.2",
    "koffi": "3.3.8",
    "mammoth": "1.13.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sherpa-onnx-node": "2.0.1",
    "unpdf": "2.2.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "dev.glimpse.app",
    "productName": "Glimpse",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "models/embeddings",
        "to": "models/embeddings"
      }
    ]
  }
}
